{
  "name": "@utexo/wdk-wallet-rgb",
  "version": "2.1.0-alpha.12",
  "description": "Isolated on-chain RGB wallet candidate for WDK.",
  "keywords": [
    "wdk",
    "wallet",
    "bip-32",
    "rgb"
  ],
  "author": "UTEXO",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/UTEXO-Protocol/wdk-wallet-rgb.git"
  },
  "main": "./onchain.js",
  "type": "module",
  "types": "./onchain.d.ts",
  "scripts": {
    "test": "node --test tests-onchain/*.test.js",
    "check:types": "tsc -p tsconfig.onchain.json"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "@tetherto/wdk-wallet": "1.0.0-beta.25",
    "bare-fs": "4.8.4",
    "bare-path": "3.1.2",
    "bare-timers": "3.2.4",
    "bare-url": "2.5.5",
    "bare-worker": "4.5.3"
  },
  "devDependencies": {
    "bare": "1.36.2",
    "bare-pack": "3.0.2",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": {
      "types": "./onchain.d.ts",
      "bare": "./onchain.js",
      "node": "./onchain.js"
    },
    "./package": "./package.json",
    "./webrgb": {
      "types": "./webrgb-onchain.d.ts",
      "react-native": "./src/onchain-webrgb.js",
      "bare": "./src/onchain-webrgb.js",
      "node": "./src/onchain-webrgb.js"
    }
  },
  "private": true,
  "engines": {
    "node": "^22.21.0 || >=24.9.0"
  },
  "files": [
    "onchain.js",
    "onchain.d.ts",
    "src/onchain-*.js",
    "src/burn-destination.js",
    "CANDIDATE.md",
    "src/onchain-bare-thread.cjs",
    "src/onchain-bare-native.json",
    "src/onchain-dev-services.json",
    "prebuilds/android-arm64/*.bare",
    "webrgb-onchain.d.ts",
    "QUALIFICATION.md"
  ],
  "imports": {
    "#onchain-webrgb-url": {
      "bare": "./src/onchain-io-bare.js",
      "default": "./src/onchain-webrgb-url.js"
    },
    "#onchain-io": {
      "bare": "./src/onchain-io-bare.js",
      "node": "./src/onchain-io-node.js"
    },
    "#onchain-worker": {
      "bare": "./src/onchain-bare-worker.js",
      "node": "./src/onchain-worker.js"
    }
  }
}
