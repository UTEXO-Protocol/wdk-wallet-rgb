+    /// Select the expected checkpoint and validate Dev transport before connecting.
+    pub fn signet_checkpoint(
+        &self,
+        network: BitcoinNetwork,
+    ) -> Result<Option<SignetCheckpoint>, Error> {
+        if let Self::DevSignetElectrum { url } = self {
+            if network != BitcoinNetwork::Signet || !dev_signet_transport(url) {
+                return Err(Error::InvalidIndexer {
+                    details: s!("Dev Signet requires a Signet network and a TLS Electrum endpoint"),
+                });
+            }
+            return Ok(Some(SignetCheckpoint::Dev));
+        }
+        Ok((network == BitcoinNetwork::Signet).then_some(SignetCheckpoint::Public))
+    }
