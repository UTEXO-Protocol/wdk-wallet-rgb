+pub(crate) fn electrum_config(
+    indexer_config: &IndexerConfig,
+    network: Option<BitcoinNetwork>,
+) -> ElectrumConfig {
+    let mut builder = ConfigBuilder::new()
         .validate_domain(true)
-        .timeout(Some(Duration::from_secs(INDEXER_TIMEOUT)))
-        .build()
+        .timeout(Some(Duration::from_secs(INDEXER_TIMEOUT)));
+    if let Some(network) = network {
+        let genesis = bitcoin::constants::genesis_block(bitcoin::Network::from(network));
+        let mut checkpoints = vec![(0, genesis.block_hash())];
+        if network == BitcoinNetwork::Signet {
+            let checkpoint = match indexer_config {
+                IndexerConfig::DevSignetElectrum { .. } => SignetCheckpoint::Dev,
+                _ => SignetCheckpoint::Public,
+            };
+            checkpoints.push((
+                1,
+                checkpoint.block_one().parse().expect("compiled Signet checkpoint"),
+            ));
+        }
+        // The Electrum client checks these on the actual replacement connection.
+        builder = builder.retry(0).chain_checkpoints(checkpoints);
+    } else {
+        // Indexer discovery does not supply wallet or resolver data.
+        builder = builder.retry(INDEXER_RETRIES);
+    }
+    builder.build()
 }
 
