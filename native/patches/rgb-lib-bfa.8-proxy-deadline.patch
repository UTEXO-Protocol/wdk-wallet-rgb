+        response.result.expect("actual parsed ACK response")
+    }
+
+    fn ambiguity_proxy(fault: &str, expiry: i64) -> (String, std::thread::JoinHandle<()>) {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let endpoint = format!("http://{}/json-rpc", listener.local_addr().unwrap());
+        let info = serde_json::json!({"jsonrpc":"2.0","id":null,"result":{
+            "protocol_version":"1.0","version":"fixture","uptime":0,"retention_grace_secs":"86400"}}).to_string();
+        let valid = |expiry: i64| {
+            serde_json::json!({"jsonrpc":"2.0","id":null,"result":{
+            "result":true,"expires_at":expiry.to_string()}})
+            .to_string()
+        };
+        let error = |code: i32| {
+            serde_json::json!({"jsonrpc":"2.0","id":null,"error":{"code":code,"message":"fixture"}})
+                .to_string()
+        };
+        let expired_only = fault == "past-expired";
+        let fault = match fault {
+            "numeric" => Some(serde_json::json!({"jsonrpc":"2.0","id":null,"result":{"result":true,"expires_at":9223372036854775807i64}}).to_string()),
+            "invalid-json" => Some("not-json".into()),
+            "drop" => None,
+            "missing-result" => Some(serde_json::json!({"jsonrpc":"2.0","id":null,"result":null}).to_string()),
+            "unproven-nack" => Some(error(-100)),
+            "past-expired" => Some(error(-105)),
+            "invalid-released-tx" => Some(serde_json::json!({"jsonrpc":"2.0","id":null,"result":{
+                "result":true,"expires_at":expiry.to_string(),"signed_tx":"not-base64",
+                "signed_tx_hash":"00".repeat(32),"sender_pk":hex::encode(ed25519_from_seed(&[8;32]).verifying_key().to_bytes())}}).to_string()),
+            _ => panic!("unknown ambiguity fixture"),
+        };
+        let replies = if expired_only {
+            vec![("ack.post", Some(error(-105)))]
+        } else {
+            vec![
+                ("server.info", Some(info.clone())),
+                ("ack.post", fault),
+                ("ack.post", Some(error(-105))),
+                ("ack.post", Some(error(-104))),
+                ("ack.post", Some(valid(expiry))),
+                ("server.info", Some(info)),
+                ("ack.post", Some(valid(expiry + 60))),
+                ("ack.post", Some(error(-105))),
+            ]
+        };
+        let server = std::thread::spawn(move || {
+            let mut original_ack = None;
+            for (method, response) in replies {
+                let (mut stream, _) = listener.accept().unwrap();
+                stream.set_nonblocking(false).unwrap();
+                stream
+                    .set_read_timeout(Some(Duration::from_secs(10)))
+                    .unwrap();
+                let mut reader = BufReader::new(stream.try_clone().unwrap());
+                let mut line = String::new();
+                reader.read_line(&mut line).unwrap();
+                assert!(line.starts_with("POST /json-rpc "));
+                let mut length = 0;
+                loop {
+                    line.clear();
+                    reader.read_line(&mut line).unwrap();
+                    if line == "\r\n" {
+                        break;
+                    }
+                    if let Some((name, value)) = line.split_once(':') {
+                        if name.eq_ignore_ascii_case("content-length") {
+                            length = value.trim().parse::<usize>().unwrap();
+                        }
+                    }
+                }
+                assert!(length > 0 && length < 4096);
+                let mut body = vec![0; length];
+                reader.read_exact(&mut body).unwrap();
+                let request: serde_json::Value = serde_json::from_slice(&body).unwrap();
+                assert_eq!(request["method"], method);
+                if method == "ack.post" {
+                    if let Some(original) = &original_ack {
+                        assert_eq!(
+                            &body, original,
+                            "only the identical signed ACK may be retried"
+                        );
+                    } else {
+                        original_ack = Some(body);
+                    }
+                }
+                if let Some(response) = response {
+                    write!(stream,"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",response.len(),response).unwrap();
+                }
+            }
+        });
+        (endpoint, server)
+    }
+
+    fn row(created: i64, expiration: i64, deadline: i64) -> DbBatchTransfer {
+        DbBatchTransfer {
+            idx: 1,
+            txid: None,
+            status: TransferStatus::WaitingBroadcast,
+            created_at: created,
+            updated_at: created,
+            expiration: Some(expiration),
+            min_confirmations: 1,
+            incoming: true,
+            operation_secret_key: Some(vec![7; 32]),
+            broadcast_deadline: Some(deadline),
+            retention_deadline: None,
+        }
+    }
+
+    pub(crate) fn run() {
+        let current = now().unix_timestamp();
+        let created = current - 3 * 86400;
+        let expiration = created + 86400;
+        let grace = MIN_SENDER_RETENTION_GRACE_SECS;
+        let mut unknown = vec![];
+        for value in [
+            None,
+            Some(""),
+            Some("nonsense"),
+            Some("-9223372036854775808"),
+            Some("-1"),
+            Some("0"),
+            Some("1"),
+            Some("9223372036854775807"),
+            Some("9223372036854689407"),
+        ] {
+            let response = peer_ack(value);
+            let mut batch = row(created, expiration, 0);
+            let deadline = broadcast_deadline(response.expires_at.as_deref(), grace, &batch);
+            assert_eq!(deadline, proxy_deadline::UNKNOWN_DEADLINE, "{value:?}");
+            batch.broadcast_deadline = Some(deadline);
+            assert!(!incoming_expired(&batch, current, false));
+            assert!(!confirmation_deadline_passed(&batch));
+            assert!(!broadcast_deadline_passed_beyond_skew_margin(&batch));
+            unknown.push(batch);
+        }
+        let mut missing = row(created, expiration, 0);
+        missing.broadcast_deadline = None;
+        assert!(!incoming_expired(&missing, current, false));
+        assert!(incoming_expired(&missing, current, true));
+        unknown.push(missing);
+        let valid_expiry = created + 600;
+        let response = peer_ack(Some(&valid_expiry.to_string()));
+        let normal = row(created, expiration, valid_expiry + i64::from(grace));
+        assert_eq!(
+            broadcast_deadline(response.expires_at.as_deref(), grace, &normal),
+            normal.broadcast_deadline.unwrap()
+        );
+        assert!(confirmation_deadline_passed(&normal));
+        for value in [i64::MIN, -1, 0, 1, i64::MAX - i64::from(grace), i64::MAX] {
+            let batch = row(created, expiration, value);
+            assert!(!confirmation_deadline_passed(&batch));
+            assert!(!incoming_expired(&batch, current, false));
+            assert!(!broadcast_deadline_passed_beyond_skew_margin(&batch));
+            unknown.push(batch);
+        }
+
+        // Store hostile old records in the real SQLite wallet DB, close the
+        // wallet and reopen it. Public fail policy must retain each reservation
+        // before any indexer access or proxy action; no mock refresh or grants.
+        let data_dir = tempfile::tempdir().unwrap();
+        let keys = crate::keys::generate_keys(BitcoinNetwork::Regtest, WitnessVersion::Taproot);
+        let wallet_data = WalletData {
+            data_dir: data_dir.path().to_str().unwrap().into(),
+            bitcoin_network: BitcoinNetwork::Regtest,
+            database_type: DatabaseType::Sqlite,
+            max_allocations_per_utxo: 5,
+            supported_schemas: vec![AssetSchema::Nia],
+            allow_reckless_schemas: false,
+        };
+        let make_wallet =
+            || Wallet::new(wallet_data.clone(), SinglesigKeys::from_keys(&keys, None)).unwrap();
+        let mut wallet = make_wallet();
+        let txn = wallet.database().begin_transaction().unwrap();
+        let mut ids = vec![];
+        for mut batch in unknown {
+            batch.idx = 0;
+            let mut model: DbBatchTransferActMod = batch.into();
+            model.idx = ActiveValue::NotSet;
+            let idx = txn.set_batch_transfer(model).unwrap();
+            let asset = txn
+                .set_asset_transfer(DbAssetTransferActMod {
+                    user_driven: ActiveValue::Set(true),
+                    batch_transfer_idx: ActiveValue::Set(idx),
+                    asset_id: ActiveValue::Set(None),
+                    transition_type: ActiveValue::Set(None),
+                    ..Default::default()
+                })
+                .unwrap();
+            txn.set_transfer(DbTransferActMod {
+                asset_transfer_idx: ActiveValue::Set(asset),
+                recipient_id: ActiveValue::Set(Some(format!("fixture-{idx}"))),
+                recipient_encryption: ActiveValue::Set(Encryption::Optional),
+                ..Default::default()
+            })
+            .unwrap();
+            txn.set_reserved_txos(vec![DbReservedTxoActMod {
+                txid: ActiveValue::Set(format!("{idx:064x}")),
+                vout: ActiveValue::Set(0),
+                reserved_for_vanilla: ActiveValue::Set(None),
+                reserved_for_colored: ActiveValue::Set(Some(idx)),
+                ..Default::default()
+            }])
+            .unwrap();
+            ids.push(idx);
+        }
+        wallet.persist_and_commit(txn).unwrap();
+        for fault in [
+            "numeric",
+            "invalid-json",
+            "drop",
+            "missing-result",
+            "unproven-nack",
+            "invalid-released-tx",
+        ] {
+            let created = current - 3600;
+            let expiration = current - 1800;
+            let (endpoint, server) = ambiguity_proxy(fault, created + 600);
+            let txn = wallet.database().begin_transaction().unwrap();
+            let mut model: DbBatchTransferActMod = row(created, expiration, 0).into();
+            model.idx = ActiveValue::NotSet;
+            model.status = ActiveValue::Set(TransferStatus::WaitingCounterparty);
+            model.broadcast_deadline = ActiveValue::Set(None);
+            let idx = txn.set_batch_transfer(model).unwrap();
+            let asset = txn
+                .set_asset_transfer(DbAssetTransferActMod {
+                    user_driven: ActiveValue::Set(true),
+                    batch_transfer_idx: ActiveValue::Set(idx),
+                    asset_id: ActiveValue::Set(None),
+                    transition_type: ActiveValue::Set(None),
+                    ..Default::default()
+                })
+                .unwrap();
+            let transfer_idx = txn
+                .set_transfer(DbTransferActMod {
+                    asset_transfer_idx: ActiveValue::Set(asset),
+                    recipient_id: ActiveValue::Set(Some(format!("ambiguity-{idx}"))),
+                    recipient_encryption: ActiveValue::Set(Encryption::Optional),
+                    proxy_transfer_id: ActiveValue::Set(Some(format!("transfer-{idx}"))),
+                    consignment_hash: ActiveValue::Set(Some("00".repeat(32))),
+                    ..Default::default()
+                })
+                .unwrap();
+            txn.set_reserved_txos(vec![DbReservedTxoActMod {
+                txid: ActiveValue::Set(format!("{idx:064x}")),
+                vout: ActiveValue::Set(0),
+                reserved_for_vanilla: ActiveValue::Set(None),
+                reserved_for_colored: ActiveValue::Set(Some(idx)),
+                ..Default::default()
+            }])
+            .unwrap();
+            let db_data = txn.get_db_data(false).unwrap();
+            let batch = txn.get_batch_transfer(idx).unwrap().unwrap();
+            let (_, transfer) = batch
+                .get_incoming_transfer(&db_data.asset_transfers, &db_data.transfers)
+                .unwrap();
+            wallet
+                .save_sender_transport_endpoint(&txn, transfer_idx, &endpoint)
+                .unwrap();
+            let mode = ReceiveMode::Proxy(ProxyReceiveData {
+                proxy_url: endpoint.clone(),
+                sender_proxy: endpoint,
+                transfer_id: format!("transfer-{idx}"),
+                sender_pubkey: String::new(),
+                consignment_hash: "00".repeat(32),
+                recipient_encryption: Encryption::Optional,
+                batch: false,
+            });
+            let mut updated: DbBatchTransferActMod = batch.clone().into();
+            // Use the same savepoint boundary as refresh_impl. Success must keep
+            // the positive ACK intent even after the remote reply becomes ambiguous.
+            let result = txn
+                .with_savepoint(|txn| {
+                    wallet.ack_consignment(
+                        txn,
+                        &batch,
+                        &transfer,
+                        &mut updated,
+                        &mode,
+                        &[7; 32],
+                        None,
+                        false,
+                    )
+                })
+                .unwrap()
+                .unwrap();
+            assert_eq!(result.status, TransferStatus::WaitingBroadcast, "{fault}");
+            assert_eq!(
+                result.broadcast_deadline,
+                Some(proxy_deadline::UNKNOWN_DEADLINE),
+                "{fault}"
+            );
+            assert_eq!(
+                txn.get_batch_transfer_transfers(idx).unwrap()[0].ack,
+                Some(true)
+            );
+            wallet.persist_and_commit(txn).unwrap();
+            // Expired/NotFound claims cannot release an unknown ACK; a later
+            // valid reply repairs it, and another valid reply cannot slide it.
+            for step in 0..5 {
+                if step == 4 {
+                    drop(wallet);
+                    wallet = make_wallet();
+                }
+                let txn = wallet.database().begin_transaction().unwrap();
+                let reservations = txn.iter_reserved_txos().unwrap();
+                let data = txn.get_db_data(false).unwrap();
+                let batch = txn.get_batch_transfer(idx).unwrap().unwrap();
+                assert!(
+                    wallet
+                        .wait_broadcast(&txn, &batch, &data)
+                        .unwrap()
+                        .is_none()
+                );
+                let after = txn.get_batch_transfer(idx).unwrap().unwrap();
+                assert_eq!(after.status, TransferStatus::WaitingBroadcast);
+                assert_eq!(txn.iter_reserved_txos().unwrap(), reservations);
+                assert_eq!(
+                    after.broadcast_deadline,
+                    Some(if step < 2 {
+                        proxy_deadline::UNKNOWN_DEADLINE
+                    } else {
+                        created + 600 + i64::from(grace)
+                    })
+                );
+                wallet.persist_and_commit(txn).unwrap();
+            }
+            server.join().unwrap();
+            ids.push(idx);
+        }
+        // A genuinely elapsed local deadline plus the FULL confirmation margin
+        // still cleans up normally. This is a synthetic historical SQLite row;
+        // no claim of a live chain confirmation or an accelerated system clock.
+        let created = current - 4 * 86400;
+        let expiration = created + 86400;
+        let deadline = created + 600 + i64::from(grace);
+        let (endpoint, server) = ambiguity_proxy("past-expired", created + 600);
+        let txn = wallet.database().begin_transaction().unwrap();
+        let mut model: DbBatchTransferActMod = row(created, expiration, deadline).into();
+        model.idx = ActiveValue::NotSet;
+        let idx = txn.set_batch_transfer(model).unwrap();
+        let asset = txn
+            .set_asset_transfer(DbAssetTransferActMod {
+                user_driven: ActiveValue::Set(true),
+                batch_transfer_idx: ActiveValue::Set(idx),
+                asset_id: ActiveValue::Set(None),
+                transition_type: ActiveValue::Set(None),
+                ..Default::default()
+            })
+            .unwrap();
+        let transfer_idx = txn
+            .set_transfer(DbTransferActMod {
+                asset_transfer_idx: ActiveValue::Set(asset),
+                recipient_id: ActiveValue::Set(Some(format!("past-expired-{idx}"))),
+                recipient_encryption: ActiveValue::Set(Encryption::Optional),
+                proxy_transfer_id: ActiveValue::Set(Some(format!("transfer-{idx}"))),
+                consignment_hash: ActiveValue::Set(Some("00".repeat(32))),
+                ..Default::default()
+            })
+            .unwrap();
+        txn.set_reserved_txos(vec![DbReservedTxoActMod {
+            txid: ActiveValue::Set(format!("{idx:064x}")),
+            vout: ActiveValue::Set(0),
+            reserved_for_vanilla: ActiveValue::Set(None),
+            reserved_for_colored: ActiveValue::Set(Some(idx)),
+            ..Default::default()
+        }])
+        .unwrap();
+        wallet
+            .save_sender_transport_endpoint(&txn, transfer_idx, &endpoint)
+            .unwrap();
+        let data = txn.get_db_data(false).unwrap();
+        let batch = txn.get_batch_transfer(idx).unwrap().unwrap();
+        assert!(confirmation_deadline_passed(&batch));
+        let failed = wallet.wait_broadcast(&txn, &batch, &data).unwrap().unwrap();
+        assert_eq!(failed.status, TransferStatus::Failed);
+        assert!(
+            !txn.iter_reserved_txos()
+                .unwrap()
+                .iter()
+                .any(|r| r.reserved_for_colored == Some(idx))
+        );
+        wallet.persist_and_commit(txn).unwrap();
+        server.join().unwrap();
+        drop(wallet);
+        wallet = make_wallet();
+        let txn = wallet.database().begin_transaction().unwrap();
+        assert_eq!(
+            txn.get_batch_transfer(idx).unwrap().unwrap().status,
+            TransferStatus::Failed
+        );
+        assert!(
+            !txn.iter_reserved_txos()
+                .unwrap()
+                .iter()
+                .any(|r| r.reserved_for_colored == Some(idx))
+        );
+        wallet.persist_and_commit(txn).unwrap();
+        drop(wallet);
+        for _ in 0..3 {
+            let mut wallet = make_wallet();
+            for &idx in &ids {
+                let txn = wallet.database().begin_transaction().unwrap();
+                let before = txn.get_batch_transfer(idx).unwrap().unwrap();
+                let reservations = txn.iter_reserved_txos().unwrap();
+                assert!(
+                    reservations
+                        .iter()
+                        .any(|r| r.reserved_for_colored == Some(idx))
+                );
+                assert!(!incoming_expired(&before, current, false));
+                let outcome = wallet
+                    .fail_transfers_impl(&txn, Some(idx), false, true)
+                    .unwrap();
+                assert!(outcome.cannot_fail);
+                assert!(!outcome.transfers_changed);
+                assert_eq!(txn.get_batch_transfer(idx).unwrap().unwrap(), before);
+                assert_eq!(txn.iter_reserved_txos().unwrap(), reservations);
+                wallet.persist_and_commit(txn).unwrap();
+            }
+        }
     }
 }
diff --git a/src/wallet/proxy_deadline.rs b/src/wallet/proxy_deadline.rs
new file mode 100644
index 0000000000000000000000000000000000000000..95ed0a7606a03b2e593c006d3b16bcdc8ec5864d
--- /dev/null
+++ b/src/wallet/proxy_deadline.rs
@@ -0,0 +1,259 @@
+//! Conservative handling of proxy deadlines. A proxy controls its reply, not the
+//! receiver's invoice window. Unknown timing must retain reservations, never make
+//! an already ACKed transfer reusable. `i64::MAX` is the persisted unknown marker;
+//! it deliberately has no elapsed deadline, including when a margin is added.
+
+pub(crate) const UNKNOWN_DEADLINE: i64 = i64::MAX;
+// Last UTC second representable by the existing time crate's normal year range.
+// Out-of-domain data is quarantined, never clamped to an earlier release time.
+const MAX_UNIX_TIMESTAMP: i64 = 253_402_300_799;
+
+pub(crate) fn valid_expiration(expiration: i64, created_at: i64, skew: u32) -> bool {
+    created_at > 0
+        && created_at <= MAX_UNIX_TIMESTAMP
+        && expiration > 0
+        && expiration <= MAX_UNIX_TIMESTAMP
+        && created_at
+            .checked_sub(i64::from(skew))
+            .is_some_and(|lower| expiration >= lower)
+}
+
+pub(crate) fn passed(deadline: i64, now: i64, margin: u32) -> bool {
+    deadline > 0
+        && deadline <= MAX_UNIX_TIMESTAMP
+        && deadline
+            .checked_add(i64::from(margin))
+            .is_some_and(|deadline| deadline < now)
+}
+
+/// Keep the entire reported grace. A smaller clamp could release a reservation
+/// while a previously handed-off transaction is still broadcastable.
+pub(crate) fn after(expiration: i64, grace: u32) -> i64 {
+    if expiration <= 0 {
+        return UNKNOWN_DEADLINE;
+    }
+    expiration
+        .checked_add(i64::from(grace))
+        .filter(|&deadline| deadline <= MAX_UNIX_TIMESTAMP)
+        .unwrap_or(UNKNOWN_DEADLINE)
+}
+
+/// The honest sender's operation expires before every recipient invoice. Allow
+/// delayed ACKs whose expiry is in the past now, but not before this invoice was
+/// created (accounting for skew). Do not turn malformed data into an early
+/// deadline or `None`: the latter falls back to invoice expiry in fail logic.
+pub(crate) fn from_peer(
+    raw: Option<&str>,
+    grace: u32,
+    created_at: i64,
+    invoice_expiration: Option<i64>,
+    skew: u32,
+) -> i64 {
+    let Some(upper) = invoice_expiration.filter(|&value| valid_expiration(value, created_at, skew))
+    else {
+        return UNKNOWN_DEADLINE;
+    };
+    let Some(expiration) = raw
+        .filter(|raw| !raw.is_empty() && raw.len() <= 19 && raw.bytes().all(|b| b.is_ascii_digit()))
+        .and_then(|raw| raw.parse::<i64>().ok())
+        .filter(|&value| valid_expiration(value, created_at, skew) && value <= upper)
+    else {
+        return UNKNOWN_DEADLINE;
+    };
+    after(expiration, grace)
+}
+
+/// Validate a previously saved deadline too. Older builds could persist hostile
+/// values. The sender grace is u32, giving a conservative maximum without ever
+/// shortening the actual grace. Unknown records can be repaired only by another
+/// validated ACK or chain evidence, never just by local-clock expiration.
+pub(crate) fn known(
+    deadline: i64,
+    created_at: i64,
+    invoice_expiration: Option<i64>,
+    skew: u32,
+    minimum_grace: u32,
+) -> bool {
+    let Some(expiration) =
+        invoice_expiration.filter(|&value| valid_expiration(value, created_at, skew))
+    else {
+        return false;
+    };
+    deadline != UNKNOWN_DEADLINE
+        && valid_expiration(deadline, created_at, skew)
+        && created_at
+            .checked_sub(i64::from(skew))
+            .and_then(|lower| lower.checked_add(i64::from(minimum_grace)))
+            .is_some_and(|lower| deadline >= lower)
+        && deadline <= after(expiration, u32::MAX)
+}
+
+/// Only the identical transaction already saved for this receive is eligible.
+/// Unknown timing keeps it live; known elapsed timing stops rebroadcasting.
+pub(crate) fn can_rebroadcast(
+    deadline: Option<i64>,
+    created_at: i64,
+    invoice_expiration: Option<i64>,
+    skew: u32,
+    minimum_grace: u32,
+    now: i64,
+) -> bool {
+    deadline.is_none_or(|deadline| {
+        !known(
+            deadline,
+            created_at,
+            invoice_expiration,
+            skew,
+            minimum_grace,
+        ) || now <= deadline
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    const CREATED: i64 = 1_800_000_000;
+    const EXPIRATION: i64 = CREATED + 86_400;
+    const SKEW: u32 = 300;
+    const GRACE: u32 = 86_400;
+
+    #[test]
+    fn hostile_peer_expirations_remain_unknown() {
+        for raw in [
+            None,
+            Some(""),
+            Some("-1"),
+            Some("0"),
+            Some("1"),
+            Some("9223372036854775807"),
+            Some("9223372036854689407"),
+            Some("9223372036854775808"),
+            Some("-9223372036854775808"),
+            Some("18446744073709551615"),
+            Some("+1800000000"),
+            Some(" 1800000000"),
+            Some("1800000000 "),
+            Some("not-a-time"),
+            Some("1800086401"),
+        ] {
+            assert_eq!(
+                from_peer(raw, GRACE, CREATED, Some(EXPIRATION), SKEW),
+                UNKNOWN_DEADLINE,
+                "{raw:?}"
+            );
+        }
+        assert_eq!(
+            from_peer(Some("1800000000"), GRACE, CREATED, None, SKEW),
+            UNKNOWN_DEADLINE
+        );
+    }
+
+    #[test]
+    fn normal_and_late_ack_expiry_preserve_exact_grace_and_skew() {
+        for expiration in [
+            CREATED - i64::from(SKEW),
+            CREATED,
+            CREATED + 600,
+            EXPIRATION,
+        ] {
+            let raw = expiration.to_string();
+            let deadline = from_peer(Some(&raw), GRACE, CREATED, Some(EXPIRATION), SKEW);
+            assert_eq!(deadline, expiration + i64::from(GRACE));
+            assert!(known(deadline, CREATED, Some(EXPIRATION), SKEW, GRACE));
+            assert!(!passed(deadline, deadline + 300, 300));
+            assert!(passed(deadline, deadline + 301, 300));
+        }
+        let before = (CREATED - i64::from(SKEW) - 1).to_string();
+        assert_eq!(
+            from_peer(Some(&before), GRACE, CREATED, Some(EXPIRATION), SKEW),
+            UNKNOWN_DEADLINE
+        );
+        assert_eq!(
+            from_peer(
+                Some("1800000000"),
+                u32::MAX,
+                CREATED,
+                Some(EXPIRATION),
+                SKEW
+            ),
+            CREATED + i64::from(u32::MAX)
+        );
+    }
+
+    #[test]
+    fn stored_extremes_never_become_elapsed_or_trusted() {
+        for value in [i64::MIN, -1, 0, 1, i64::MAX - i64::from(GRACE), i64::MAX] {
+            assert!(
+                !known(value, CREATED, Some(EXPIRATION), SKEW, GRACE),
+                "{value}"
+            );
+            if value <= 0 || value >= i64::MAX - 300 {
+                assert!(!passed(value, CREATED, 300));
+            }
+        }
+        assert!(!known(CREATED, CREATED, Some(EXPIRATION), SKEW, GRACE));
+        assert!(!known(
+            i64::MAX - 100000,
+            CREATED,
+            Some(i64::MAX),
+            SKEW,
+            GRACE
+        ));
+        assert!(!valid_expiration(i64::MIN, CREATED, SKEW));
+        assert!(!valid_expiration(0, CREATED, SKEW));
+        assert!(!valid_expiration(1, CREATED, SKEW));
+        assert!(!passed(i64::MAX, i64::MAX, u32::MAX));
+        assert_eq!(after(i64::MAX, 1), UNKNOWN_DEADLINE);
+        assert_eq!(after(i64::MIN, u32::MAX), UNKNOWN_DEADLINE);
+        assert_eq!(after(0, 1), UNKNOWN_DEADLINE);
+    }
+
+    #[test]
+    fn saved_tx_rebroadcast_retains_unknown_but_respects_known_cutoff() {
+        for value in [
+            None,
+            Some(i64::MIN),
+            Some(-1),
+            Some(0),
+            Some(1),
+            Some(UNKNOWN_DEADLINE),
+        ] {
+            assert!(can_rebroadcast(
+                value,
+                CREATED,
+                Some(EXPIRATION),
+                SKEW,
+                GRACE,
+                EXPIRATION + 200000
+            ));
+        }
+        let deadline = CREATED + 600 + i64::from(GRACE);
+        assert!(can_rebroadcast(
+            Some(deadline),
+            CREATED,
+            Some(EXPIRATION),
+            SKEW,
+            GRACE,
+            deadline
+        ));
+        assert!(!can_rebroadcast(
+            Some(deadline),
+            CREATED,
+            Some(EXPIRATION),
+            SKEW,
+            GRACE,
+            deadline + 1
+        ));
+    }
+
+    #[test]
+    fn valid_ack_can_replace_unknown_without_extending_known_deadline() {
+        let old = UNKNOWN_DEADLINE;
+        assert!(!known(old, CREATED, Some(EXPIRATION), SKEW, GRACE));
+        let new = from_peer(Some("1800000600"), GRACE, CREATED, Some(EXPIRATION), SKEW);
+        assert!(known(new, CREATED, Some(EXPIRATION), SKEW, GRACE));
+        // The callsite consults a new ACK only for an unknown stored deadline.
+        // It must not slide this known deadline forward on every refresh.
+        assert_eq!(new, CREATED + 600 + i64::from(GRACE));
+    }
+}
