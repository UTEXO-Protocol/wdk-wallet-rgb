+    fn call_chain_checked<T>(
+        &self,
+        read_only: bool,
+        request: impl Fn(&ClientType) -> Result<T, Error>,
+    ) -> Result<T, Error> {
+        // Keep replacement and the following request on the same admitted connection.
+        let mut socket = self.client_type.write().unwrap();
+        let connect = || ClientType::from_config(&self.url, &self.config);
+        let is_transport_error =
+            |error: &Error| matches!(error, Error::IOError(_) | Error::SharedIOError(_));
+        if socket.is_none() {
+            *socket = Some(connect()?);
+        }
+        if !read_only {
+            // Detect an already dead connection before sending a request we cannot repeat.
+            if let Err(error) = dispatch_client!(socket.as_ref().unwrap(), ping) {
+                if !is_transport_error(&error) {
+                    return Err(error);
+                }
+                *socket = None;
+                *socket = Some(connect()?);
+            }
+        }
+
+        let result = request(socket.as_ref().unwrap());
+        if !result.as_ref().is_err_and(is_transport_error) {
+            return result;
+        }
+        *socket = None;
+        if !read_only {
+            return result;
+        }
+
+        let fresh = connect()?;
+        let result = request(&fresh);
+        if !result.as_ref().is_err_and(is_transport_error) {
+            *socket = Some(fresh);
+        }
+        result
+    }
+}
