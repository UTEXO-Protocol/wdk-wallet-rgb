+// A mint with a concealed or unrelated extra output must never cause the recipient to
+// acknowledge a lock larger than the amount it receives.
+fn mint_amount_matches(requested: Option<u64>, amounts: impl Iterator<Item = u64>, total: u64) -> bool {
