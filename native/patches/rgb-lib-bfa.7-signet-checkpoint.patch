+#[cfg(feature = "_validation")]
+pub(crate) type IndexerResolver = Box<dyn rgbstd::indexers::Indexer + Send>;
+
+#[cfg(feature = "electrum_validation")]
+struct DevSignetResolver(rgbstd::indexers::electrum_blocking::ElectrumClient);
+
+#[cfg(feature = "electrum_validation")]
+impl ResolveWitness for DevSignetResolver {
+    fn check_chain_net(&self, chain_net: ChainNet) -> Result<(), WitnessResolverError> {
+        use rgbstd::indexers::electrum_blocking::electrum_client::Param;
+
+        if chain_net != ChainNet::BitcoinSignet {
+            return Err(WitnessResolverError::WrongChainNet);
+        }
+        let request_error =
+            |err: ElectrumError| WitnessResolverError::ResolverIssue(None, err.to_string());
+        let client = &self.0.inner;
+        let genesis = client.block_header(0).map_err(request_error)?.block_hash();
+        let expected_genesis =
+            bitcoin::constants::genesis_block(bitcoin::Network::Signet).block_hash();
+        if genesis != expected_genesis
+            || self
+                .get_block_header(NonZeroU32::MIN)?
+                .block_hash()
+                .to_string()
+                != SignetCheckpoint::Dev.block_one()
+        {
+            return Err(WitnessResolverError::WrongChainNet);
+        }
+
+        // rgb-ops probes a public Signet transaction ID for BitcoinSignet. Dev uses the
+        // same RGB chain identity, so test verbose support with Dev's own block one.
+        let txid = client.txid_from_pos(1, 0).map_err(request_error)?;
+        let transaction = client
+            .raw_call(
+                "blockchain.transaction.get",
+                [Param::String(txid.to_string()), Param::Bool(true)],
+            )
+            .map_err(request_error)?;
+        if !transaction
+            .get("hex")
+            .and_then(|hex| hex.as_str())
+            .is_some_and(|hex| !hex.is_empty())
+        {
+            return Err(WitnessResolverError::InvalidResolverData);
+        }
+        Ok(())
+    }
+
+    fn resolve_witness(&self, witness_id: RgbTxid) -> Result<WitnessStatus, WitnessResolverError> {
+        self.0.resolve_witness(witness_id)
+    }
+
+    fn get_block_header(&self, height: NonZeroU32) -> Result<BlockHeader, WitnessResolverError> {
+        self.0.get_block_header(height)
+    }
+}
+
