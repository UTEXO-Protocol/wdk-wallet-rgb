+    fn ok(path: &str, body: &str) -> Reply {
+        Reply {
+            request_line: format!("GET {path} HTTP/1.1"),
+            status: "200 OK",
+            extra_headers: String::new(),
+            body: body.into(),
+        }
+    }
+
+    fn redirect(request_line: &str, destination: &str) -> Reply {
+        Reply {
+            request_line: request_line.into(),
+            status: "307 Temporary Redirect",
+            extra_headers: format!("Location: {destination}\r\n"),
+            body: String::new(),
+        }
+    }
+
+    fn serve(replies: Vec<Reply>) -> (String, std::thread::JoinHandle<()>) {
+        let listener = TcpListener::bind("127.0.0.1:0").expect("bind Esplora fixture");
+        listener.set_nonblocking(true).expect("nonblocking fixture");
+        let url = format!("http://{}", listener.local_addr().expect("fixture address"));
+        let worker = std::thread::spawn(move || {
+            for reply in replies {
+                let deadline = Instant::now() + Duration::from_secs(5);
+                let mut stream = loop {
+                    match listener.accept() {
+                        Ok((stream, _)) => break stream,
+                        Err(err)
+                            if err.kind() == std::io::ErrorKind::WouldBlock
+                                && Instant::now() < deadline =>
+                        {
+                            std::thread::sleep(Duration::from_millis(2));
+                        }
+                        Err(err) => panic!("expected {}: {err}", reply.request_line),
+                    }
+                };
+                stream
+                    .set_nonblocking(false)
+                    .expect("blocking accepted stream");
+                stream
+                    .set_read_timeout(Some(Duration::from_secs(5)))
+                    .unwrap();
+                let mut reader = BufReader::new(&mut stream);
+                let mut line = String::new();
+                reader.read_line(&mut line).expect("request line");
+                assert_eq!(line.trim_end(), reply.request_line);
+                let mut length = 0;
+                loop {
+                    line.clear();
+                    assert_ne!(reader.read_line(&mut line).expect("request header"), 0);
+                    if line == "\r\n" {
+                        break;
+                    }
+                    if let Some(value) = line.to_ascii_lowercase().strip_prefix("content-length:") {
+                        length = value.trim().parse().expect("request content length");
+                    }
+                }
+                if reply.request_line.starts_with("POST") {
+                    assert!(length > 0);
+                    reader
+                        .read_exact(&mut vec![0; length])
+                        .expect("broadcast transaction");
+                }
+                write!(
+                    stream,
+                    "HTTP/1.1 {}\r\nContent-Length: {}\r\n{}Connection: close\r\n\r\n{}",
+                    reply.status,
+                    reply.body.len(),
+                    reply.extra_headers,
+                    reply.body
+                )
+                .expect("serve Esplora response");
+            }
+        });
+        (url, worker)
+    }
+
+    fn wallet_online(url: String, data_dir: &std::path::Path) -> Result<(Wallet, Online), Error> {
+        let network = BitcoinNetwork::Signet;
+        let keys = crate::keys::generate_keys(network, WitnessVersion::Taproot);
+        let mut wallet = Wallet::new(
+            WalletData {
+                data_dir: data_dir.to_str().expect("UTF-8 fixture path").into(),
+                bitcoin_network: network,
+                database_type: DatabaseType::Sqlite,
+                max_allocations_per_utxo: 5,
+                supported_schemas: vec![AssetSchema::Nia],
+            },
+            SinglesigKeys::from_keys(&keys, None),
+        )?;
+        let online = wallet.go_online(OnlineOptions {
+            indexer_config: IndexerConfig::DevSignetEsplora { url },
+            skip_consistency_check: true,
+            vanilla_sync_lookback: 0,
+            failed_witness_receive_grace_secs: 0,
+            proxy_auth_keys: HashMap::new(),
+            evm_chains: HashMap::new(),
+        })?;
+        Ok((wallet, online))
+    }
+
+    pub(crate) fn run() {
+        let genesis = bitcoin::constants::genesis_block(bitcoin::Network::Signet)
+            .block_hash()
+            .to_string();
+        let dev = SignetCheckpoint::Dev.block_one();
+        let public = SignetCheckpoint::Public.block_one();
+        let header_path = format!("/block/{dev}/header");
+        let genesis_reply = || ok("/block-height/0", &genesis);
+        let height_one = |hash| ok("/block-height/1", hash);
+        let data_dir = tempfile::tempdir().expect("temporary wallet directory");
+
+        for (replies, should_accept) in [
+            (
+                vec![
+                    genesis_reply(),
+                    height_one(dev),
+                    genesis_reply(),
+                    height_one(dev),
+                    ok(&header_path, DEV_HEADER),
+                ],
+                true,
+            ),
+            (vec![genesis_reply(), height_one(public)], false),
+            (
+                vec![ok(
+                    "/block-height/0",
+                    &bitcoin::constants::genesis_block(bitcoin::Network::Bitcoin)
+                        .block_hash()
+                        .to_string(),
+                )],
+                false,
+            ),
+            (
+                vec![
+                    genesis_reply(),
+                    Reply {
+                        request_line: "GET /block-height/1 HTTP/1.1".into(),
+                        status: "404 Not Found",
+                        extra_headers: String::new(),
+                        body: String::new(),
+                    },
+                ],
+                false,
+            ),
+            (
+                vec![
+                    genesis_reply(),
+                    height_one(dev),
+                    genesis_reply(),
+                    height_one(public),
+                ],
+                false,
+            ),
+            (
+                vec![
+                    genesis_reply(),
+                    height_one(dev),
+                    genesis_reply(),
+                    height_one(dev),
+                    ok(&header_path, PUBLIC_HEADER),
+                ],
+                false,
+            ),
+        ] {
+            let (url, fixture) = serve(replies);
+            let result = wallet_online(url, data_dir.path());
+            assert_eq!(result.is_ok(), should_accept, "{:?}", result.as_ref().err());
+            fixture.join().expect("wallet fixture completed");
+        }
+
+        let (url, fixture) = serve(vec![
+            genesis_reply(),
+            height_one(dev),
+            ok("/blocks/tip/height", "1"),
+            height_one(dev),
+        ]);
+        assert_eq!(check_dev_esplora_tip(&url).unwrap(), (1, dev.into()));
+        fixture.join().expect("tip fixture completed");
+
+        let (url, fixture) = serve(vec![
+            genesis_reply(),
+            height_one(dev),
+            ok("/blocks/tip/height", "0"),
+        ]);
+        assert!(check_dev_esplora_tip(&url).is_err());
+        fixture
+            .join()
+            .expect("below-checkpoint tip fixture completed");
+
+        let (url, fixture) = serve(vec![
+            genesis_reply(),
+            height_one(dev),
+            ok("/blocks/tip/height", "1"),
+            height_one(public),
+        ]);
+        assert!(check_dev_esplora_tip(&url).is_err());
+        fixture
+            .join()
+            .expect("wrong checkpoint tip fixture completed");
+
+        let (url, fixture) = serve(vec![
+            genesis_reply(),
+            height_one(dev),
+            genesis_reply(),
+            height_one(dev),
+            ok(&header_path, DEV_HEADER),
+            genesis_reply(),
+            height_one(public),
+        ]);
+        let (mut wallet, online) = wallet_online(url, data_dir.path()).expect("Dev online wallet");
+        let result = wallet.sync(
+            online,
+            SyncOptions {
+                keychain: SyncKeychain::Colored,
+                strategy: SyncStrategy::FastSync,
+            },
+        );
+        assert!(matches!(result, Err(Error::InvalidIndexer { .. })));
+        fixture.join().expect("wallet switch fixture completed");
+
+        let target = TcpListener::bind("127.0.0.1:0").expect("redirect target");
+        target.set_nonblocking(true).unwrap();
+        let destination = format!("http://{}/unexpected", target.local_addr().unwrap());
+        let (url, fixture) = serve(vec![redirect("GET /block-height/0 HTTP/1.1", &destination)]);
+        assert!(check_dev_esplora_tip(&url).is_err());
+        fixture.join().expect("GET fixture completed");
+
+        let (url, fixture) = serve(vec![
+            genesis_reply(),
+            height_one(dev),
+            genesis_reply(),
+            height_one(dev),
+            redirect(&format!("GET {header_path} HTTP/1.1"), &destination),
+        ]);
+        assert!(wallet_online(url, data_dir.path()).is_err());
+        fixture.join().expect("resolver redirect fixture completed");
+
+        let tx = bitcoin::Transaction {
+            version: bitcoin::transaction::Version::TWO,
+            lock_time: bitcoin::absolute::LockTime::ZERO,
+            input: vec![],
+            output: vec![],
+        };
+        let (url, fixture) = serve(vec![
+            genesis_reply(),
+            height_one(dev),
+            ok(&header_path, DEV_HEADER),
+            genesis_reply(),
+            height_one(public),
+        ]);
+        let resolver = get_resolver(
+            &IndexerConfig::DevSignetEsplora { url },
+            BitcoinNetwork::Signet,
+        )
+        .expect("Dev SPV proof resolver");
+        assert!(matches!(
+            resolver.resolve_spv_proof(tx.compute_txid()),
+            Err(WitnessResolverError::WrongChainNet)
+        ));
+        fixture
+            .join()
+            .expect("SPV proof chain switch fixture completed");
+
+        let (url, fixture) = serve(vec![redirect("POST /tx HTTP/1.1", &destination)]);
+        let error = dev_esplora_client(&url)
+            .unwrap()
+            .broadcast(&tx)
+            .unwrap_err();
+        assert!(matches!(
+            error,
+            EsploraError::HttpResponse { status: 307, .. }
+        ));
+        fixture.join().expect("broadcast fixture completed");
+        assert_eq!(
+            target.accept().unwrap_err().kind(),
+            std::io::ErrorKind::WouldBlock
+        );
+    }
+
+    #[test]
+    fn dev_esplora_admission_uses_both_clients_and_rejects_redirects() {
+        run();
+    }
+}
