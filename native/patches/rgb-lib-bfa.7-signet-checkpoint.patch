+/// The block-one checkpoint that distinguishes Signet chains with the same genesis.
+#[cfg(feature = "_validation")]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SignetCheckpoint {
+    /// Bitcoin's public Signet.
+    Public,
+    /// UTEXO's Dev Signet.
+    Dev,
+}
+
+#[cfg(feature = "_validation")]
+impl SignetCheckpoint {
+    /// Expected hash of block one.
+    pub const fn block_one(self) -> &'static str {
+        match self {
+            Self::Public => "00000086d6b2636cb2a392d45edc4ec544a10024d30141c9adf4bfd9de533b53",
+            Self::Dev => "0000001b808e4ece11c0cd922eaf9eee8d7dfba7e23e90b4f9614248daaf72cb",
+        }
+    }
+}
