+#[cfg(feature = "esplora_validation")]
+struct DevSignetEsploraResolver(rgbstd::indexers::esplora_blocking::EsploraClient);
+
+#[cfg(feature = "esplora_validation")]
+impl ResolveWitness for DevSignetEsploraResolver {
+    fn check_chain_net(&self, chain_net: ChainNet) -> Result<(), WitnessResolverError> {
+        if chain_net != ChainNet::BitcoinSignet {
+            return Err(WitnessResolverError::WrongChainNet);
+        }
+        self.0.check_chain_net(chain_net)?;
+        let expected: bitcoin::BlockHash = SignetCheckpoint::Dev
+            .block_one()
+            .parse()
+            .expect("the compiled checkpoint is a valid block hash");
+        let height_one = self
+            .0
+            .inner
+            .get_block_hash(1)
+            .map_err(|err| WitnessResolverError::ResolverIssue(None, err.to_string()))?;
+        if height_one != expected {
+            return Err(WitnessResolverError::WrongChainNet);
+        }
+        let header = self
+            .0
+            .inner
+            .get_header_by_hash(&height_one)
+            .map_err(|err| WitnessResolverError::ResolverIssue(None, err.to_string()))?;
+        if header.block_hash() != expected {
+            return Err(WitnessResolverError::WrongChainNet);
+        }
+        Ok(())
+    }
+
+    fn resolve_witness(&self, witness_id: RgbTxid) -> Result<WitnessStatus, WitnessResolverError> {
+        self.0.resolve_witness(witness_id)
+    }
+
+    fn get_block_header(&self, height: NonZeroU32) -> Result<BlockHeader, WitnessResolverError> {
+        self.0.get_block_header(height)
+    }
+}
+
+#[cfg(feature = "esplora_validation")]
