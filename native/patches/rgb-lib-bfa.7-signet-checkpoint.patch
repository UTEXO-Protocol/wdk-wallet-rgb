+    fn resolve_spv_proof(
+        &self,
+        txid: RgbTxid,
+    ) -> Result<rgbstd::validation::SpvProof, WitnessResolverError> {
+        self.check_chain_net(ChainNet::BitcoinSignet)?;
+        self.0.resolve_spv_proof(txid)
+    }
+}
