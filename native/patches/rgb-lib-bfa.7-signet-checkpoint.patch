+#[cfg(feature = "_validation")]
+fn dev_signet_transport(url: &str) -> bool {
+    let Ok(endpoint) = reqwest::Url::parse(url) else {
+        return false;
+    };
+    if endpoint.host_str().is_none()
+        || endpoint.port().is_none_or(|port| port == 0)
+        || !endpoint.username().is_empty()
+        || endpoint.password().is_some()
+        || !endpoint.path().is_empty()
+        || endpoint.query().is_some()
+        || endpoint.fragment().is_some()
+    {
+        return false;
+    }
+    #[cfg(test)]
+    if url.starts_with("tcp://127.0.0.1:") {
+        return endpoint.host_str() == Some("127.0.0.1");
+    }
+    url.starts_with("ssl://")
+}
+
+#[cfg(feature = "_validation")]
+fn invalid_dev_esplora() -> Error {
+    Error::InvalidIndexer {
+        details: s!("Dev Signet requires a Signet network and an HTTPS Esplora endpoint"),
+    }
+}
+
+#[cfg(feature = "_validation")]
+fn dev_esplora_endpoint(url: &str) -> Result<(reqwest::Url, BitcoinNetwork), Error> {
+    let endpoint = reqwest::Url::parse(url).map_err(|_| invalid_dev_esplora())?;
+    if endpoint.host_str().is_none()
+        || endpoint.port() == Some(0)
+        || !endpoint.username().is_empty()
+        || endpoint.password().is_some()
+        || endpoint.query().is_some()
+        || endpoint.fragment().is_some()
+    {
+        return Err(invalid_dev_esplora());
+    }
+    #[cfg(test)]
+    if endpoint.scheme() == "http" && endpoint.host_str() == Some("127.0.0.1") {
+        return Ok((endpoint, BitcoinNetwork::Regtest));
+    }
+    if endpoint.scheme() != "https" {
+        return Err(invalid_dev_esplora());
+    }
+    Ok((endpoint, BitcoinNetwork::Signet))
+}
+
+#[cfg(feature = "_validation")]
+pub(crate) fn check_signet_indexer(
+    checkpoint: Option<SignetCheckpoint>,
+    genesis: &str,
+    read_block_one: impl FnOnce() -> Result<String, Error>,
+) -> Result<(), Error> {
+    if let Some(checkpoint) = checkpoint {
+        let expected_genesis =
+            bitcoin::constants::genesis_block(bitcoin::Network::Signet).block_hash();
+        if genesis != expected_genesis.to_string() || read_block_one()? != checkpoint.block_one() {
+            return Err(Error::InvalidIndexer {
+                details: s!("the indexer reports a different Signet chain"),
+            });
+        }
+    }
+    Ok(())
+}
