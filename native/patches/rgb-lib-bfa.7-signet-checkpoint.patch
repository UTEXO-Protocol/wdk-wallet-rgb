+/// Return a height and matching block hash after checking the Dev Signet Esplora checkpoint.
+#[cfg(feature = "esplora")]
+pub fn check_dev_esplora_tip(url: &str) -> Result<(u32, String), Error> {
+    let config = IndexerConfig::DevSignetEsplora { url: url.into() };
+    let client = IndexerClient::new(&config, BitcoinNetwork::Signet)?;
+    let height = client.get_latest_block_height()?;
+    if height == 0 {
+        return Err(Error::InvalidIndexer {
+            details: s!("the indexer reports a tip below the Dev Signet checkpoint"),
+        });
+    }
+    let block_hash = client.block_hash(height as usize)?;
+    if height == 1 && block_hash != SignetCheckpoint::Dev.block_one() {
+        return Err(Error::InvalidIndexer {
+            details: s!("the indexer reports a different Signet chain"),
+        });
+    }
+    Ok((height, block_hash))
+}
