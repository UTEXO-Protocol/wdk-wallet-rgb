diff --git a/src/api/egress.rs b/src/api/egress.rs
new file mode 100644
index 0000000..1d1eeb0
--- /dev/null
+++ b/src/api/egress.rs
@@ -0,0 +1,258 @@
+use std::{
+    io,
+    net::{IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr},
+    sync::Arc,
+    time::Duration,
+};
+
+use reqwest::{
+    Url,
+    blocking::Client,
+    dns::{Addrs, Name, Resolve, Resolving},
+};
+
+use crate::BitcoinNetwork;
+
+fn refused() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::PermissionDenied,
+        "HTTP endpoint is outside the wallet network policy",
+    )
+}
+
+fn public_v4(address: Ipv4Addr) -> bool {
+    match address.octets() {
+        [0 | 10 | 127 | 224..=255, ..]
+        | [100, 64..=127, ..]
+        | [169, 254, ..]
+        | [172, 16..=31, ..]
+        | [192, 0, 0 | 2, _]
+        | [192, 88, 99, _]
+        | [192, 168, ..]
+        | [198, 18 | 19, ..]
+        | [198, 51, 100, _]
+        | [203, 0, 113, _] => false,
+        _ => true,
+    }
+}
+
+fn public_v6(address: Ipv6Addr) -> bool {
+    let [first, second, ..] = address.segments();
+    // Keep global unicast only. Exclude special-use, documentation and transition ranges.
+    (0x2000..=0x3fff).contains(&first)
+        && !matches!(
+            (first, second),
+            (0x2001, 0..=0x01ff | 0x0db8) | (0x2002, _) | (0x3fff, 0..=0x0fff)
+        )
+}
+
+fn address_allowed(address: IpAddr, local: bool) -> bool {
+    if local {
+        address == IpAddr::V4(Ipv4Addr::LOCALHOST) || address == IpAddr::V6(Ipv6Addr::LOCALHOST)
+    } else {
+        match address {
+            IpAddr::V4(address) => public_v4(address),
+            IpAddr::V6(address) => public_v6(address),
+        }
+    }
+}
+
+fn admit_url(raw: &str, local: bool) -> io::Result<(Url, Option<String>)> {
+    let authority = raw
+        .split_once("://")
+        .map(|(_, rest)| rest.split(['/', '?', '#']).next().unwrap_or_default())
+        .ok_or_else(refused)?;
+    if raw.len() > 4096
+        || authority.is_empty()
+        || authority.contains('@')
+        || raw.contains('\\')
+        || raw.chars().any(|ch| ch.is_control() || ch.is_whitespace())
+    {
+        return Err(refused());
+    }
+    let url = Url::parse(raw).map_err(|_| refused())?;
+    if !(url.scheme() == "https" || local && url.scheme() == "http")
+        || !url.username().is_empty()
+        || url.password().is_some()
+        || url.fragment().is_some()
+        || url.port() == Some(0)
+    {
+        return Err(refused());
+    }
+    let host = url.host_str().ok_or_else(refused)?;
+    let host = host.trim_start_matches('[').trim_end_matches(']');
+    if let Ok(ip) = host.parse::<IpAddr>() {
+        return if address_allowed(ip, local) {
+            Ok((url, None))
+        } else {
+            Err(refused())
+        };
+    }
+
+    let dns_name = host.trim_end_matches('.');
+    if local {
+        if dns_name != "localhost" {
+            return Err(refused());
+        }
+    } else if !dns_name.contains('.')
+        || [".localhost", ".local", ".internal", ".home.arpa"]
+            .iter()
+            .any(|suffix| dns_name.ends_with(suffix))
+    {
+        return Err(refused());
+    }
+    let host = host.to_owned();
+    Ok((url, Some(host)))
+}
+
+#[cfg(feature = "_online")]
+pub(crate) fn is_loopback_http_url(raw: &str) -> bool {
+    admit_url(raw, true).is_ok()
+}
+
+fn admit_answers(addresses: impl Iterator<Item = SocketAddr>) -> io::Result<Vec<SocketAddr>> {
+    let addresses: Vec<_> = addresses.take(33).collect();
+    if addresses.is_empty()
+        || addresses.len() > 32
+        || !addresses
+            .iter()
+            .all(|addr| address_allowed(addr.ip(), false))
+    {
+        return Err(refused());
+    }
+    Ok(addresses)
+}
+
+struct WalletDns {
+    host: Option<String>,
+    local: bool,
+}
+
+impl Resolve for WalletDns {
+    fn resolve(&self, name: Name) -> Resolving {
+        let host = name.as_str().to_owned();
+        let admitted = self.host.as_deref() == Some(host.as_str());
+        let local = self.local;
+        Box::pin(async move {
+            if !admitted {
+                return Err(refused().into());
+            }
+            // The connector receives only these checked addresses. A separate DNS preflight
+            // would allow the answer to change before the socket is opened.
+            let addresses = if local {
+                vec![
+                    SocketAddr::new(Ipv4Addr::LOCALHOST.into(), 0),
+                    SocketAddr::new(Ipv6Addr::LOCALHOST.into(), 0),
+                ]
+            } else {
+                // Avoid resolver search domains changing the meaning of an untrusted hostname.
+                let absolute_host = format!("{}.", host.trim_end_matches('.'));
+                admit_answers(tokio::net::lookup_host((absolute_host.as_str(), 0)).await?)?
+            };
+            Ok(Box::new(addresses.into_iter()) as Addrs)
+        })
+    }
+}
+
+/// Build a direct, network-scoped HTTP client for one untrusted wallet endpoint.
+///
+/// TLS verification uses the original URL hostname. The same resolver that validates every DNS
+/// answer supplies the socket addresses to the connector, and no redirect or system proxy can
+/// replace the target. Regtest accepts loopback only.
+pub fn wallet_http_client_for_network(
+    raw: &str,
+    network: BitcoinNetwork,
+    connect_timeout: Duration,
+    timeout: Duration,
+) -> io::Result<(Client, Url)> {
+    let local = network == BitcoinNetwork::Regtest;
+    let (url, host) = admit_url(raw, local)?;
+    let builder = Client::builder()
+        .no_proxy()
+        .redirect(reqwest::redirect::Policy::none())
+        .retry(reqwest::retry::never())
+        .dns_resolver(Arc::new(WalletDns { host, local }))
+        .connect_timeout(connect_timeout)
+        .timeout(timeout);
+    // The embedded Android client uses the vendored native backend and system roots.
+    // Rustls's Android platform verifier would require a Java initialization hook.
+    #[cfg(target_os = "android")]
+    let builder = builder.tls_backend_native();
+    let client = builder.build().map_err(io::Error::other)?;
+    Ok((client, url))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn public_urls_reject_nonpublic_destinations_and_ambiguous_authority() {
+        for raw in [
+            "http://wallet.example.com/",
+            "https://0x7f000001/",
+            "https://2130706433/",
+            "https://127.1/",
+            "https://10.0.0.1/",
+            "https://100.64.0.1/",
+            "https://169.254.169.254/",
+            "https://172.31.255.255/",
+            "https://192.168.0.1/",
+            "https://198.18.0.1/",
+            "https://224.0.0.1/",
+            "https://[::ffff:8.8.8.8]/",
+            "https://[fe80::1]/",
+            "https://[fc00::1]/",
+            "https://[2002:7f00:0001::]/",
+            "https://localhost./",
+            "https://host.local/",
+            "https://@wallet.example.com/",
+            "https:///wallet.example.com/",
+            "https://name:pass@wallet.example.com/",
+            "https://wallet.example.com/#fragment",
+            "https://wallet.example.com:0/",
+        ] {
+            assert!(admit_url(raw, false).is_err(), "{raw}");
+        }
+        for raw in [
+            "https://8.8.8.8:443/path",
+            "https://[2606:4700::1111]/path",
+            "https://wallet.example.com/path?signature=example",
+        ] {
+            assert!(admit_url(raw, false).is_ok(), "{raw}");
+        }
+    }
+
+    #[test]
+    fn regtest_admits_only_loopback() {
+        for raw in [
+            "http://127.0.0.1:49090/json-rpc",
+            "http://[::1]:49090/json-rpc",
+            "http://localhost:49090/json-rpc",
+        ] {
+            assert!(admit_url(raw, true).is_ok(), "{raw}");
+        }
+        for raw in [
+            "http://127.0.0.2/",
+            "https://wallet.example.com/",
+            "https://8.8.8.8/",
+        ] {
+            assert!(admit_url(raw, true).is_err(), "{raw}");
+        }
+    }
+
+    #[test]
+    fn dns_filters_the_actual_address_pool_and_refuses_mixed_answers() {
+        let public: SocketAddr = "8.8.8.8:0".parse().unwrap();
+        let private: SocketAddr = "127.0.0.1:0".parse().unwrap();
+        let v6: SocketAddr = "[2606:4700::1111]:0".parse().unwrap();
+        assert_eq!(
+            admit_answers([public, v6].into_iter()).unwrap(),
+            [public, v6]
+        );
+        assert!(admit_answers([public, private].into_iter()).is_err());
+        assert!(admit_answers([private].into_iter()).is_err());
+        assert!(admit_answers(std::iter::empty()).is_err());
+        assert!(admit_answers(std::iter::repeat_n(public, 33)).is_err());
+    }
+}
